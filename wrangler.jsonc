{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "porlaanarquia",
  "compatibility_date": "2026-11-05",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "porlaanarquia.antarquia.cl/*",
      "zone_name": "antarquia.cl"
    }
  ]
}
